# Postgres. Defaults assume a local server with a "postgres" user and no password; change user/password/host if yours differ.
# App data. Create once: createdb talotrace_dev
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/talotrace_dev
# pytest only; dropped and recreated on every test run. Create once: createdb talotrace_test
TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/talotrace_test

# Scorer (Step 6)
ANTHROPIC_API_KEY=
SCORER_MODEL=claude-opus-5-5

# Signs the HR sign-in cookie. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
